# Application
NODE_ENV=development
PORT=5001
APP_NAME=Edyn Digital Hub API
API_PREFIX=/api/v1

# Frontend and CORS (comma-separated)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# Supabase PostgreSQL
# For this long-running Express server, copy the Supavisor Session pooler URL
# shown under Supabase Dashboard > Connect. It normally ends in port 5432.
# DATABASE_URL is used by the running API.
# DIRECT_URL is used by Prisma migrations. It can initially use the same
# Session pooler URL; use the direct URL later if your network supports it.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Supabase Auth and private Storage (server only)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SECRET_KEY
SUPABASE_EBOOK_BUCKET=ebooks

# Initial administrator used by `npm run prisma:seed`.
# Set a unique strong password before seeding a production database.
SEED_ADMIN_EMAIL=admin@ednascorner.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-password

# Paystack (use sk_test_ locally and sk_live_ only in production)
PAYSTACK_SECRET_KEY=sk_test_REPLACE_ME
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/payment/callback

# Secure ebook delivery
DOWNLOAD_TOKEN_SECRET=replace-with-at-least-32-random-characters
EBOOK_LINK_TTL_SECONDS=900
MAX_EBOOK_DOWNLOADS=3

# Optional notifications
CONTACT_NOTIFICATION_EMAIL=

# Cloudinary authenticated ebook storage
CLOUDINARY_CLOUD_NAME=su7zhqoe
CLOUDINARY_API_KEY=YOUR_API_KEY
CLOUDINARY_API_SECRET=YOUR_API_SECRET
CLOUDINARY_UPLOAD_PRESET=edyndigital_hub
CLOUDINARY_EBOOK_FOLDER=edyndigitalhub/ebooks
CLOUDINARY_DOWNLOAD_TTL_SECONDS=300
CLOUDINARY_MAX_UPLOAD_BYTES=10485760
EBOOK_GRANT_TTL_DAYS=30
